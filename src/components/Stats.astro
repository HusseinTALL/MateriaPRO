---
const stats = [
  { value: 5, label: "Familles de produits" },
  { value: 14, label: "Zones livrées à Ouagadougou" },
  { value: 48, suffix: "h", label: "Délai maximum de devis" },
  { value: 100, suffix: "%", label: "Lots inspectés avant livraison" },
];
---

<!-- ══════════════ 8 · STATISTIQUES ══════════════ -->
<section class="section stats" id="stats">
  <div class="stats__bg" aria-hidden="true"></div>
  <div class="container">
    <div class="stats__grid">
      {
        stats.map((s) => (
          <div class="stat" data-reveal>
            <span class="stat__value">
              <span class="counter" data-target={s.value}>0</span>
              {s.suffix && <em>{s.suffix}</em>}
            </span>
            <span class="stat__label">{s.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
