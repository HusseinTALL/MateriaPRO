---
const steps = [
  {
    title: "Contact & demande de devis",
    text: "Par téléphone, WhatsApp ou formulaire — décrivez vos besoins : produits, quantités, lieu du chantier.",
  },
  {
    title: "Devis détaillé",
    text: "Sous 24–48 h : produits, quantités, transport et délais — tout compris pour Ouagadougou.",
  },
  {
    title: "Validation & paiement",
    text: "Comptant ou acompte selon votre profil client, avec confirmation écrite de la commande.",
  },
  {
    title: "Commande usine & contrôle qualité",
    text: "Le lot est inspecté à l'enlèvement selon la fiche de contrôle qualité (FCQ) : checklist, photos, verdict.",
  },
  {
    title: "Organisation de la livraison",
    text: "Tournée planifiée par zone, transporteur confirmé, créneau de passage communiqué à l'avance.",
  },
  {
    title: "Réception sur chantier",
    text: "Vérification du lot avec vous, bon de livraison signé — les réserves éventuelles sont notées immédiatement.",
  },
  {
    title: "Facturation & suivi",
    text: "Facture claire, traitement des réserves et accompagnement dans la durée pour vos prochains chantiers.",
  },
];
---

<!-- ══════════════ 5 · COMMENT ÇA MARCHE ══════════════ -->
<section class="section process" id="processus">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow" data-reveal>Le parcours</p>
        <h2 class="h2" data-split>De votre demande<br />à la réception sur chantier.</h2>
      </div>
      <p class="section-head__note" data-reveal>
        Sept étapes maîtrisées. Les délais sont précisés au cas par cas
        dans chaque devis, selon le produit et la disponibilité usine.
      </p>
    </div>

    <ol class="process__list">
      <li class="process__track" aria-hidden="true"><span id="processLine"></span></li>
      {
        steps.map((s, i) => (
          <li class="process__step" data-reveal>
            <span class="process__num">{i + 1}</span>
            <div>
              <h3 set:html={s.title}></h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
